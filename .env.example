# ─── Meta WhatsApp Cloud API credentials ─────────────────────────────────────
# Get these from https://developers.facebook.com/apps → your app → WhatsApp → API Setup

# Temporary access token (regenerates every 24 h on the test number — copy a fresh one each session)
WHATSAPP_TOKEN=

# Phone Number ID — this is the Meta test number for development
# Test number: +1 (555) 148-7133  |  Phone Number ID: 1346175845241870
WHATSAPP_PHONE_NUMBER_ID=1346175845241870

# Any secret string you choose — must match exactly what you enter in the
# Meta webhook configuration page under "Verify token"
WHATSAPP_VERIFY_TOKEN=ovenart-verify-token

# ─── Bakery staff notification ────────────────────────────────────────────────
# WhatsApp number that receives completed order summaries.
# E.164 digits only (no + or leading zeros), e.g. 263771234567
# Leave blank during development — orders will be printed to the console instead.
BAKERY_NOTIFY_NUMBER=

# Optional — name of an approved WhatsApp Message Template used to notify
# staff (business-initiated: staff haven't messaged the bot, so a template is
# the only reliable way to reach them). Without this set, staff must message
# the bot at least once every 24h to keep the free-form notification working.
# See docs/staff-notification-template.md.
BAKERY_ORDER_TEMPLATE_NAME=
BAKERY_ORDER_TEMPLATE_LANG=en

# ─── Order spreadsheet (Google Form → Sheet) ──────────────────────────────────
# Optional — leave blank to skip. When set, every confirmed order is submitted
# to a Google Form whose "Responses" tab is linked to a live Sheet for the
# packing/dispatch team. See docs/google-sheets-setup.md for how to get these.
GOOGLE_FORM_URL=
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_CITY=
GOOGLE_FORM_ENTRY_PHONE=
GOOGLE_FORM_ENTRY_FULFILLMENT=
GOOGLE_FORM_ENTRY_ITEMS=
GOOGLE_FORM_ENTRY_TOTAL=

# ─── Sales dashboard (live inbox) ─────────────────────────────────────────────
# Optional — leave both blank to disable the /dashboard page entirely.
# Basic Auth credentials for the sales team's live inbox at /dashboard.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
